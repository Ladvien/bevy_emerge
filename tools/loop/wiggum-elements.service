[Unit]
Description=bevy_elements Wiggum loop (one fresh build-loop pass at a time)
Documentation=file:%h/bevy_elements/.omp/commands/build-loop.md
After=network-online.target
Wants=network-online.target

# **`Restart=on-failure`, not `always`, and the difference matters here.** `bevy_elements` has its own
# driver (`scripts/bevy-build-loop.sh`) which exits **1** when a pass fails and **2** when a pass added no
# loop-log entry, on purpose: those are its signal that the loop is stuck, and the command says *"if
# blocked, log the blocker and pick the next item"*. `Restart=always` would immediately start another
# pass and erase that signal; `on-failure` retries a killed process (a reboot, an OOM) but respects a
# deliberate stop. `StartLimit*` are `[Unit]` keys — in `[Service]` systemd ignores them with a warning,
# which is a mistake this repo already made once.
StartLimitIntervalSec=86400
StartLimitBurst=3
# One iteration is hours of work (capture, judge, research, implement, benchmark, gate), so a burst of
# retries inside an hour is always wrong. Three tries a day, then stop and wait for a human.

[Service]
Type=simple
WorkingDirectory=%h/bevy_elements

# **Their driver, not the generic one.** It is the right tool: it requires `main` with no tracked changes
# before each pass, detects a pass that added no `## Iteration` entry to `docs/loop-log.md`, holds a
# `flock` so two drivers cannot interleave, and kills a pass at `LOOP_TIMEOUT`. The generic
# `tools/loop/wiggum.sh` drives *any* repo but cannot read this crate's progress signal.
ExecStart=%h/bevy_elements/scripts/bevy-build-loop.sh

# **`LOOP_MAX` is high on purpose: it must not be what ends the loop.** Their driver exits **0** when it
# reaches `LOOP_MAX`, and `Restart=on-failure` ignores a clean exit — so a small number here means the
# loop silently finishes and nothing ever restarts it. This is a backstop against an infinite run, not a
# schedule: the loop is meant to keep going, and a human stops it. At ~2.5 h a pass this is about 42 days.
Environment=LOOP_MAX=400
# Six hours per pass: the command budgets capture → judge → research → implement → benchmark → gate, and
# an honest pass at this crate's gates has taken that long. Not the 75 minutes a bevy_emerge pass gets.
Environment=LOOP_TIMEOUT=6h
# Stop after a single pass that adds no loop-log entry: at six hours each, two silent passes is a day
# wasted, and their driver's own default already says 1.
Environment=LOOP_NO_PROGRESS=1
Environment=LOOP_STATE=%h/.local/state/bevy-elements-loop

# **systemd's PATH is not a login shell's.** Measured on the sibling unit: `omp` lives in `~/.local/bin`,
# and without this the pass died `rc=127` while the unit reported `active (running)`.
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=RUST_BACKTRACE=1

# **Under the machine's other work.** big also runs `hs-distill` (10 GB RSS), a bevy_emerge loop, and
# GitHub Actions runners in podman. Measured while starting this: load 40.9 on 24 cores, 5 GB RAM
# available, 21 GB of swap already in use. A release build of this crate is the heaviest thing the box
# does, so it goes below everything else rather than competing with it.
Nice=19
IOSchedulingClass=idle
# No `MemoryMax`: a release build legitimately needs gigabytes, and a hard cap turns a slow build into an
# OOM kill that the command would have to interpret as a code failure.

# **Every pass does GPU work** (the command demands captures from many angles and a benchmark), so it needs
# the card. Measured: 8.2 GB of 24 GB VRAM free with `hs-distill` holding 15 GB, which the command's 1920x1080
# captures and `bench_elements` fit in. If VRAM ever runs out the pass fails loudly on `request_adapter`
# rather than silently degrading — that is the behaviour the command already documents.

# **Stopping is done with the stop file, not with SIGTERM.** Their driver checks `$LOOP_STATE/STOP`
# between passes and finishes the one in flight; a SIGTERM instead makes the `timeout` wrapper kill the
# pass, which is a *failed* pass, which their driver treats as fatal — an iteration's work lost and an
# `exit 1`. So:
#   systemctl --user stop wiggum@elements   <- only when you mean "kill the running iteration"
#   touch ~/.local/state/bevy-elements-loop/STOP  <- the graceful stop
# `TimeoutStopSec` is still long, because a pass mid-capture or mid-commit is the worst thing to cut.
KillSignal=SIGTERM
TimeoutStopSec=25200

Restart=on-failure
RestartSec=300

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
