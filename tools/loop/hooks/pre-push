#!/usr/bin/env bash
# The push gate for loop worker clones (`git config core.hooksPath tools/loop/hooks`). Owner, 2026-10-29.
# A push to main runs the deterministic gate on the commit being pushed and is refused when it fails.
# Measured 2026-10-29: passes that skipped `cargo test --workspace` pushed tests failing 165 of 200 runs.
set -u
zero=0000000000000000000000000000000000000000
target="" code=0
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$zero" ] && continue
  target="$local_sha"
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    code=1
  elif git diff --name-only "$remote_sha" "$local_sha" | grep -qvE '^docs/|\.md$|\.(gif|mp4|png|jpg|webp)$'; then
    code=1
  fi
done
[ -n "$target" ] || exit 0
refuse() { echo "pre-push gate: REFUSED: $*" >&2; echo "pre-push gate: fix it, or log the item as blocked; never --no-verify." >&2; exit 1; }
[ "$(git rev-parse HEAD)" = "$target" ] || refuse "push the checked-out commit (HEAD $(git rev-parse --short HEAD), pushing ${target:0:9})"
[ -z "$(git status --porcelain -- crates Cargo.toml Cargo.lock tools)" ] || refuse "uncommitted changes under crates/, Cargo.*, tools/ would be tested instead of the commit; commit or stash them"
python3 tools/loop/backlog.py check >/dev/null || refuse "python3 tools/loop/backlog.py check failed"
python3 tools/changelog/changelog.py check >/dev/null || refuse "python3 tools/changelog/changelog.py check failed"
if [ "$code" = 0 ]; then echo "pre-push gate: docs and media only; backlog and changelog checks passed" >&2; exit 0; fi
echo "pre-push gate: clippy and cargo test --workspace on ${target:0:9}; this takes minutes, so give git push a timeout of 1800 s or more" >&2
start=$(date +%s)
cargo clippy --workspace --all-targets -q -- -D warnings || refuse "cargo clippy --workspace --all-targets -- -D warnings failed"
cargo test --workspace -q --no-fail-fast || refuse "cargo test --workspace failed (the failing tests are named above)"
echo "pre-push gate: passed in $(( $(date +%s) - start ))s" >&2
