<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  THE BEVY_ELEMENTS WIGGUM LOOP ON big_mac (Apple Silicon, M1 Max).

  Runs `tools/loop/wiggum.sh`, the family's generic Wiggum driver — **not** this repo's own
  `scripts/bevy-build-loop.sh`, which needs `flock` and `timeout`. Neither exists on macOS and there is
  no coreutils here (measured: `timeout --foreground 5 echo hi` exits 127), so that driver cannot run on
  this host at all. The generic driver is the same shape — one fresh `omp` per pass, never mid-edit — and
  its per-pass ceiling is implemented as a pid watchdog rather than with `timeout(1)` (commit 338c5d3).

  The tradeoff, accepted deliberately: no `## Iteration` progress detection. A pass that produces
  nothing is therefore not detected, and `WIGGUM_MAX` + the agent's own `KeepAlive` are the backstops.
  Read `docs/loop-log.md` in the clone after each pass instead of relying on a detector.

  Install:
    cp com.ladvien.wiggum-elements.plist ~/Library/LaunchAgents/
    launchctl bootout  gui/$(id -u)/com.ladvien.wiggum-elements 2>/dev/null
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.ladvien.wiggum-elements.plist
    launchctl kickstart -k gui/$(id -u)/com.ladvien.wiggum-elements

  Read:
    tail -f ~/.local/state/wiggum/bevy_elements/driver.log
    ls -t ~/.local/state/wiggum/bevy_elements/passes/ | head -1

  Drain (lets the pass in flight FINISH, then exits; cuts nothing; launchd does not restart a clean exit, so
  start it again with `launchctl start com.ladvien.wiggum-elements`):
    WIGGUM_REPO=$HOME/bevy_elements ~/bevy_elements/tools/loop/wiggum.sh drain --wait

  Stop (ends the pass in flight within seconds, then exits; the driver snapshots its tree):
    WIGGUM_REPO=$HOME/bevy_elements ~/bevy_elements/tools/loop/wiggum.sh stop
-->
<!--
  `USER` is a placeholder: the install step rewrites every `/Users/USER` to the real account name
  (`sed -i '' "s|/Users/USER|$HOME|g"`), because launchd does not expand `$HOME` or `~` in
  `ProgramArguments`, `WorkingDirectory`, `StandardOutPath` or `EnvironmentVariables`.
  SUBSTITUTION
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ladvien.wiggum-elements</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/USER/bevy_elements/tools/loop/wiggum.sh</string>
    <string>__driver</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/USER/bevy_elements</string>

  <key>RunAtLoad</key>
  <false/>

  <!-- **`Crashed` only.** The generic driver exits 0 when it honours its stop file and when it reaches
       `WIGGUM_MAX`, and `KeepAlive.SuccessfulExit=false` would relaunch a loop the operator just
       stopped, making `stop` impossible to observe. `Crashed` restarts only a real crash. -->
  <key>KeepAlive</key>
  <dict>
    <key>Crashed</key>
    <true/>
  </dict>

  <!-- An iteration is hours; a 10-minute throttle is only about not spinning on a crash loop. -->
  <key>ThrottleInterval</key>
  <integer>600</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd's PATH is minimal and does not include omp or the toolchain. Measured on this family:
         without it every pass dies rc=127 while the job still reports it is running. -->
    <key>PATH</key>
    <string>/Users/USER/.local/bin:/Users/USER/.cargo/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/USER</string>
    <key>WIGGUM_REPO</key>
    <string>/Users/USER/bevy_elements</string>
    <key>WIGGUM_COMMAND</key>
    <string>build-loop</string>
    <key>WIGGUM_MODEL</key>
    <string>claude-sonnet-5-5</string>
    <key>WIGGUM_THINK</key>
    <string>medium</string>
    <key>WIGGUM_SLEEP</key>
    <string>60</string>
    <!-- **Backstop, not a schedule.** The driver exits 0 at the cap, so a small number means the loop
         silently finishes. 400 passes is weeks; it is meant to run until a human stops it. -->
    <key>WIGGUM_MAX</key>
    <string>400</string>
    <!-- Six hours: capture -> judge -> research -> implement -> benchmark -> gate is genuinely that big
         at this crate's bar. -->
    <key>WIGGUM_PASS_TIMEOUT</key>
    <string>21600</string>
    <!-- The crate has no rust-toolchain.toml and `wgsl-types` needs >= 1.97.1; this machine's default
         `stable` is 1.94, which fails the build outright. Measured. -->
    <key>RUSTUP_TOOLCHAIN</key>
    <string>1.98.1</string>
    <!-- A release build of this crate is the heaviest job the machine does. Six of ten cores leaves
         room for the emerge loop, whose tests also compile hard. -->
    <key>CARGO_BUILD_JOBS</key>
    <string>6</string>
    <key>RUST_BACKTRACE</key>
    <string>1</string>
    <!-- The skill captures on the GPU through a window; `xvfb-run` does not exist on macOS, so the
         example renders on the native Metal surface instead. Kept explicit so nothing looks for X. -->
    <key>METAL_DEVICE_WRAPPER_TYPE</key>
    <string>1</string>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/USER/Library/Logs/wiggum-elements/out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USER/Library/Logs/wiggum-elements/err.log</string>

  <!-- Generous: launchd's SIGKILL comes after this long. The driver exits within seconds of a stop, because it ends the pass in flight. -->
  <key>ExitTimeOut</key>
  <integer>25200</integer>
</dict>
</plist>
